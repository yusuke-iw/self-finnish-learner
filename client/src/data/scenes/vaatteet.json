  "infoCards": [
    {
      "id": "vaatteet-1",
      "title": {
        "fi": "Pukeudu sään mukaan",
        "selko": "Pue vaatteet sään mukaan",
        "en": "Dress for the weather",
        "ja": "天気に合わせて着る"
      },
      "body": [
        {
          "fi": "Suomessa sää vaihtelee paljon, ja pakkasella pitää suojata pää, kädet ja jalat.",
          "selko": "Suomessa sää vaihtelee. Kun on kylmä, pue lämpimät vaatteet.",
          "en": "The weather in Finland changes a lot, and in freezing weather you should cover your head, hands and feet.",
          "ja": "フィンランドは天気の変化が大きく、氷点下では頭・手・足を守る必要があります。"
        },
        {
          "fi": "Ulos lähtiessä katsotaan ensin sääennuste.",
          "selko": "Katso ensin sääennuste. Sitten lähde ulos.",
          "en": "Before going out, people usually check the forecast first.",
          "ja": "出かける前にまず天気予報を見るのが普通です。"
        }
      ],
      "grammarNote": {
        "fi": "laittaa + kohde + päähän / jalkaan / käteen; pukea + kohde + päälle",
        "selko": "laittaa pipo päähän; pukea takki päälle",
        "en": "laittaa + object + päähän / jalkaan / käteen; pukea + object + päälle",
        "ja": "「laittaa＋目的語＋päähän／jalkaan／käteen」「pukea＋目的語＋päälle」で身につける動作を言う。"
      }
    },
    {
      "id": "vaatteet-2",
      "title": {
        "fi": "Lämpötila ja astetta",
        "selko": "Lämpötila",
        "en": "Temperature",
        "ja": "気温の言い方"
      },
      "body": [
        {
          "fi": "Lämpötilan kanssa käytetään sanaa astetta: kymmenen astetta lämmintä, viisitoista astetta pakkasta.",
          "selko": "Sanotaan: kymmenen astetta lämmintä. Tai: viisitoista astetta pakkasta.",
          "en": "Temperatures use the word astetta: ten degrees above zero, fifteen degrees below zero.",
          "ja": "気温には astetta を使います。「kymmenen astetta lämmintä（10度）」「viisitoista astetta pakkasta（氷点下15度）」。"
        }
      ],
      "grammarNote": {
        "fi": "numero + astetta + lämmintä / pakkasta",
        "selko": "kymmenen astetta lämmintä",
        "en": "number + astetta + lämmintä / pakkasta (partitive)",
        "ja": "数詞＋astetta＋lämmintä／pakkasta（分格）。"
      }
    }
  ]
