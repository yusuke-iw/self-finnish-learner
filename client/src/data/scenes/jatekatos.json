    {
      "id": "jatekatos-1",
      "title": {
        "fi": "Jätekatos",
        "selko": "Jätekatos",
        "en": "The waste shelter",
        "ja": "ごみ置き場"
      },
      "body": [
        {
          "fi": "Kerrostalon pihalla on usein jätekatos. Siellä on eri astiat eri jätteille.",
          "selko": "Talon pihalla on jätekatos. Siellä on monta astiaa.",
          "en": "An apartment building often has a waste shelter in the yard, with separate bins for different kinds of waste.",
          "ja": "集合住宅の庭にはたいていごみ置き場があり、ごみの種類ごとに箱が分かれています。"
        },
        {
          "fi": "Lajitteluohjeet voivat vaihdella kunnittain. Katso ohjeet jätekatoksen seinästä.",
          "selko": "Ohjeet ovat jätekatoksen seinässä.",
          "en": "Sorting rules can vary by municipality. Check the instructions on the wall of the waste shelter.",
          "ja": "分け方は自治体によって少し違います。ごみ置き場の壁の案内を見ましょう。"
        }
      ],
      "grammarNote": {
        "fi": "kuulua + mihin? → biojätteeseen, lasinkeräykseen",
        "selko": "kuulua + mihin?",
        "en": "kuulua + illative: \"belongs in\"",
        "ja": "「kuulua＋入格」で「〜に入れるものだ」。"
      }
    }
  ]
